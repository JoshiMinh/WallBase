{
  "$schema": "https://wallbase.app/schemas/source-v1.json",
  "id": "pexels",
  "name": "Pexels",
  "version": "1.2.0",
  "versionCode": 3,
  "iconUrl": "https://www.pexels.com/favicon.ico",
  "baseUrl": "https://www.pexels.com",
  "description": "Free high-quality 4K stock photos and aesthetic phone wallpapers",
  "author": "WallBase Community",
  "isNsfw": false,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8"
  },
  "feeds": [
    {
      "id": "wallpapers",
      "title": "Aesthetic Wallpapers",
      "url": "https://www.pexels.com/search/wallpaper/?page={page}",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "html",
        "itemSelector": "article[data-testid='item'], [data-testid='photo-card'], div[data-testid='grid-item'], div.MediaCard_card__",
        "fields": {
          "id": { "selector": "a[href*='photo']", "attribute": "href", "regex": "(?:photo/.*-([0-9]+)|photo/([0-9]+)|-([0-9]+)/?)" },
          "title": { "selector": "img", "attribute": "alt", "defaultValue": "Pexels Wallpaper", "transform": "html_unescape" },
          "thumbnailUrl": {
            "selector": "img",
            "attribute": "src",
            "regexReplace": { "find": "\\?.*", "replace": "?auto=compress&cs=tinysrgb&dpr=1&w=500" }
          },
          "fullUrl": {
            "selector": "img",
            "attribute": "src",
            "regexReplace": { "find": "\\?.*", "replace": "?auto=compress&cs=tinysrgb&dpr=1&h=2560" }
          },
          "sourceUrl": { "selector": "a[href*='photo']", "attribute": "href", "transform": "prepend_base_url" }
        }
      }
    },
    {
      "id": "phone_wallpapers",
      "title": "Phone Wallpapers",
      "url": "https://www.pexels.com/search/phone%20wallpaper/?page={page}",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "html",
        "itemSelector": "article[data-testid='item'], [data-testid='photo-card'], div[data-testid='grid-item'], div.MediaCard_card__",
        "fields": {
          "id": { "selector": "a[href*='photo']", "attribute": "href", "regex": "(?:photo/.*-([0-9]+)|photo/([0-9]+)|-([0-9]+)/?)" },
          "title": { "selector": "img", "attribute": "alt", "defaultValue": "Pexels Wallpaper", "transform": "html_unescape" },
          "thumbnailUrl": {
            "selector": "img",
            "attribute": "src",
            "regexReplace": { "find": "\\?.*", "replace": "?auto=compress&cs=tinysrgb&dpr=1&w=500" }
          },
          "fullUrl": {
            "selector": "img",
            "attribute": "src",
            "regexReplace": { "find": "\\?.*", "replace": "?auto=compress&cs=tinysrgb&dpr=1&h=2560" }
          },
          "sourceUrl": { "selector": "a[href*='photo']", "attribute": "href", "transform": "prepend_base_url" }
        }
      }
    }
  ],
  "search": {
    "id": "search",
    "title": "Search Pexels",
    "url": "https://www.pexels.com/search/{query}/?page={page}",
    "pagination": {
      "type": "page_number",
      "startPage": 1,
      "step": 1
    },
    "extraction": {
      "format": "html",
      "itemSelector": "article[data-testid='item'], [data-testid='photo-card'], div[data-testid='grid-item'], div.MediaCard_card__",
      "fields": {
        "id": { "selector": "a[href*='photo']", "attribute": "href", "regex": "(?:photo/.*-([0-9]+)|photo/([0-9]+)|-([0-9]+)/?)" },
        "title": { "selector": "img", "attribute": "alt", "defaultValue": "Pexels Wallpaper", "transform": "html_unescape" },
        "thumbnailUrl": {
          "selector": "img",
          "attribute": "src",
          "regexReplace": { "find": "\\?.*", "replace": "?auto=compress&cs=tinysrgb&dpr=1&w=500" }
        },
        "fullUrl": {
          "selector": "img",
          "attribute": "src",
          "regexReplace": { "find": "\\?.*", "replace": "?auto=compress&cs=tinysrgb&dpr=1&h=2560" }
        },
        "sourceUrl": { "selector": "a[href*='photo']", "attribute": "href", "transform": "prepend_base_url" }
      }
    }
  }
}
