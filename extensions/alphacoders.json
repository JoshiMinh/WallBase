{
  "$schema": "https://wallbase.app/schemas/source-v1.json",
  "id": "alphacoders",
  "name": "AlphaCoders",
  "version": "1.3.0",
  "versionCode": 4,
  "iconUrl": "https://images.alphacoders.com/icons/favicon.ico",
  "baseUrl": "https://wall.alphacoders.com",
  "description": "Ultra HD anime, gaming, sci-fi, movies, and pop-culture wallpapers",
  "author": "WallBase Community",
  "isNsfw": false,
  "headers": {
    "Referer": "https://wall.alphacoders.com/",
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36"
  },
  "feeds": [
    {
      "id": "newest",
      "title": "Newest Wallpapers",
      "url": "https://wall.alphacoders.com/newest_wallpapers.php?page={page}",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "html",
        "itemSelector": ".thumb-container-big, .thumb-container, div.boxgrid, div.wallpaper-thumb",
        "fields": {
          "id": { "selector": "a[href*='wallpaper'], a[href*='big.php']", "attribute": "href", "regex": "(?:wallpaper/|i=)([0-9]+)" },
          "title": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "alt", "transform": "html_unescape" },
          "thumbnailUrl": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "src" },
          "width": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "src", "regex": "thumb-([0-9]{3,5})-" },
          "fullUrl": {
            "selector": "img.thumb-img, img.img-responsive, img",
            "attribute": "src",
            "regexReplace": { "find": "thumb-[0-9]+-|thumbbig-|thumb-", "replace": "" }
          },
          "sourceUrl": { "selector": "a[href*='wallpaper'], a[href*='big.php']", "attribute": "href", "transform": "prepend_base_url" }
        }
      }
    },
    {
      "id": "featured",
      "title": "Featured / Popular",
      "url": "https://wall.alphacoders.com/featured.php?page={page}",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "html",
        "itemSelector": ".thumb-container-big, .thumb-container, div.boxgrid, div.wallpaper-thumb",
        "fields": {
          "id": { "selector": "a[href*='wallpaper'], a[href*='big.php']", "attribute": "href", "regex": "(?:wallpaper/|i=)([0-9]+)" },
          "title": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "alt", "transform": "html_unescape" },
          "thumbnailUrl": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "src" },
          "width": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "src", "regex": "thumb-([0-9]{3,5})-" },
          "fullUrl": {
            "selector": "img.thumb-img, img.img-responsive, img",
            "attribute": "src",
            "regexReplace": { "find": "thumb-[0-9]+-|thumbbig-|thumb-", "replace": "" }
          },
          "sourceUrl": { "selector": "a[href*='wallpaper'], a[href*='big.php']", "attribute": "href", "transform": "prepend_base_url" }
        }
      }
    }
  ],
  "search": {
    "id": "search",
    "title": "Search Wallpapers",
    "url": "https://wall.alphacoders.com/search.php?search={query}&page={page}",
    "pagination": {
      "type": "page_number",
      "startPage": 1,
      "step": 1
    },
    "extraction": {
      "format": "html",
      "itemSelector": ".thumb-container-big, .thumb-container, div.boxgrid, div.wallpaper-thumb",
      "fields": {
        "id": { "selector": "a[href*='wallpaper'], a[href*='big.php']", "attribute": "href", "regex": "(?:wallpaper/|i=)([0-9]+)" },
        "title": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "alt", "transform": "html_unescape" },
        "thumbnailUrl": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "src" },
        "width": { "selector": "img.thumb-img, img.img-responsive, img", "attribute": "src", "regex": "thumb-([0-9]{3,5})-" },
        "fullUrl": {
          "selector": "img.thumb-img, img.img-responsive, img",
          "attribute": "src",
          "regexReplace": { "find": "thumb-[0-9]+-|thumbbig-|thumb-", "replace": "" }
        },
        "sourceUrl": { "selector": "a[href*='wallpaper'], a[href*='big.php']", "attribute": "href", "transform": "prepend_base_url" }
      }
    }
  }
}
