{
  "$schema": "https://wallbase.app/schemas/source-v1.json",
  "id": "pixiv",
  "name": "Pixiv",
  "version": "1.3.0",
  "versionCode": 4,
  "iconUrl": "https://www.google.com/s2/favicons?sz=128&domain=pixiv.net",
  "baseUrl": "https://www.pixiv.net",
  "description": "Japanese illustration community, daily rankings, and anime art",
  "author": "WallBase Community",
  "isNsfw": false,
  "headers": {
    "Referer": "https://www.pixiv.net/",
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36"
  },
  "feeds": [
    {
      "id": "daily_ranking",
      "title": "Daily Top Ranking",
      "url": "https://www.pixiv.net/ranking.php?mode=daily&content=illust&p={page}&format=json",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "json",
        "itemSelector": "contents",
        "fields": {
          "id": { "jsonPath": "illust_id" },
          "title": { "jsonPath": "title", "transform": "html_unescape" },
          "thumbnailUrl": { "jsonPath": "url" },
          "fullUrl": {
            "jsonPath": "url",
            "transform": "pixiv_master"
          },
          "sourceUrl": { "jsonPath": "illust_id", "transform": "pixiv_artwork" },
          "width": { "jsonPath": "width" },
          "height": { "jsonPath": "height" }
        }
      }
    },
    {
      "id": "weekly_ranking",
      "title": "Weekly Top Ranking",
      "url": "https://www.pixiv.net/ranking.php?mode=weekly&content=illust&p={page}&format=json",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "json",
        "itemSelector": "contents",
        "fields": {
          "id": { "jsonPath": "illust_id" },
          "title": { "jsonPath": "title", "transform": "html_unescape" },
          "thumbnailUrl": { "jsonPath": "url" },
          "fullUrl": {
            "jsonPath": "url",
            "transform": "pixiv_master"
          },
          "sourceUrl": { "jsonPath": "illust_id", "transform": "pixiv_artwork" },
          "width": { "jsonPath": "width" },
          "height": { "jsonPath": "height" }
        }
      }
    }
  ],
  "search": {
    "id": "search",
    "title": "Search Pixiv",
    "url": "https://www.pixiv.net/ajax/search/artworks/{query}?word={query}&order=date_d&mode=all&p={page}&s_mode=s_tag",
    "pagination": {
      "type": "page_number",
      "startPage": 1,
      "step": 1
    },
    "extraction": {
      "format": "json",
      "itemSelector": "body.illustManga.data",
      "fields": {
        "id": { "jsonPath": "id" },
        "title": { "jsonPath": "title", "transform": "html_unescape" },
        "thumbnailUrl": { "jsonPath": "url" },
        "fullUrl": {
          "jsonPath": "url",
          "transform": "pixiv_master"
        },
        "sourceUrl": { "jsonPath": "id", "transform": "pixiv_artwork" },
        "width": { "jsonPath": "width" },
        "height": { "jsonPath": "height" }
      }
    }
  }
}
