{
  "$schema": "https://wallbase.app/schemas/source-v1.json",
  "id": "unsplash",
  "name": "Unsplash",
  "version": "1.2.0",
  "versionCode": 3,
  "iconUrl": "https://unsplash.com/favicon-32x32.png",
  "baseUrl": "https://unsplash.com",
  "description": "High-resolution photography and curated aesthetic wallpapers",
  "author": "WallBase Community",
  "isNsfw": false,
  "headers": {
    "Accept": "application/json",
    "User-Agent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36"
  },
  "feeds": [
    {
      "id": "wallpapers",
      "title": "Wallpapers Editorial",
      "url": "https://unsplash.com/napi/topics/wallpapers/photos?page={page}&per_page={limit}",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "json",
        "fields": {
          "id": { "jsonPath": "id" },
          "title": { "jsonPath": "alt_description", "fallbackJsonPath": "description", "defaultValue": "Unsplash Wallpaper", "transform": "html_unescape" },
          "thumbnailUrl": { "jsonPath": "urls.small", "fallbackJsonPath": "urls.thumb" },
          "fullUrl": { "jsonPath": "urls.full", "fallbackJsonPath": "urls.regular" },
          "sourceUrl": { "jsonPath": "links.html" },
          "width": { "jsonPath": "width" },
          "height": { "jsonPath": "height" }
        }
      }
    },
    {
      "id": "curated",
      "title": "Curated Popular",
      "url": "https://unsplash.com/napi/photos?page={page}&per_page={limit}&order_by=popular",
      "pagination": {
        "type": "page_number",
        "startPage": 1,
        "step": 1
      },
      "extraction": {
        "format": "json",
        "fields": {
          "id": { "jsonPath": "id" },
          "title": { "jsonPath": "alt_description", "fallbackJsonPath": "description", "defaultValue": "Unsplash Wallpaper", "transform": "html_unescape" },
          "thumbnailUrl": { "jsonPath": "urls.small", "fallbackJsonPath": "urls.thumb" },
          "fullUrl": { "jsonPath": "urls.full", "fallbackJsonPath": "urls.regular" },
          "sourceUrl": { "jsonPath": "links.html" },
          "width": { "jsonPath": "width" },
          "height": { "jsonPath": "height" }
        }
      }
    }
  ],
  "search": {
    "id": "search",
    "title": "Search Unsplash",
    "url": "https://unsplash.com/napi/search/photos?query={query}&page={page}&per_page={limit}",
    "pagination": {
      "type": "page_number",
      "startPage": 1,
      "step": 1
    },
    "extraction": {
      "format": "json",
      "itemSelector": "results",
      "fields": {
        "id": { "jsonPath": "id" },
        "title": { "jsonPath": "alt_description", "fallbackJsonPath": "description", "defaultValue": "Unsplash Wallpaper", "transform": "html_unescape" },
        "thumbnailUrl": { "jsonPath": "urls.small", "fallbackJsonPath": "urls.thumb" },
        "fullUrl": { "jsonPath": "urls.full", "fallbackJsonPath": "urls.regular" },
        "sourceUrl": { "jsonPath": "links.html" },
        "width": { "jsonPath": "width" },
        "height": { "jsonPath": "height" }
      }
    }
  }
}
