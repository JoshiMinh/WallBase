{
  "$schema": "https://wallbase.app/schemas/source-v1.json",
  "id": "pinterest",
  "name": "Pinterest",
  "version": "1.1.0",
  "versionCode": 2,
  "iconUrl": "https://www.google.com/s2/favicons?sz=128&domain=pinterest.com",
  "baseUrl": "https://www.pinterest.com",
  "description": "Curated Ultra HD aesthetic wallpaper collections from Pinterest",
  "author": "WallBase Community",
  "isNsfw": false,
  "feeds": [
    {
      "id": "ultrahd",
      "title": "Ultra HD Collections",
      "url": "https://api.pinterest.com/v3/pidgets/boards/wallpapersden/ultra-hd-wallpapers-collections/pins/",
      "pagination": {
        "type": "none"
      },
      "extraction": {
        "format": "json",
        "itemSelector": "data.pins",
        "fields": {
          "id": { "jsonPath": "id" },
          "title": { "jsonPath": "description", "defaultValue": "Pinterest Wallpaper" },
          "thumbnailUrl": { "jsonPath": "images.237x.url" },
          "fullUrl": { "jsonPath": "images.orig.url" },
          "sourceUrl": { "jsonPath": "link" }
        }
      }
    },
    {
      "id": "amoled",
      "title": "AMOLED & Dark Wallpapers",
      "url": "https://api.pinterest.com/v3/pidgets/boards/wallpapersden/amoled-wallpapers/pins/",
      "pagination": {
        "type": "none"
      },
      "extraction": {
        "format": "json",
        "itemSelector": "data.pins",
        "fields": {
          "id": { "jsonPath": "id" },
          "title": { "jsonPath": "description", "defaultValue": "AMOLED Wallpaper" },
          "thumbnailUrl": { "jsonPath": "images.237x.url" },
          "fullUrl": { "jsonPath": "images.orig.url" },
          "sourceUrl": { "jsonPath": "link" }
        }
      }
    },
    {
      "id": "anime",
      "title": "Anime Aesthetic",
      "url": "https://api.pinterest.com/v3/pidgets/boards/wallpapersden/anime-wallpapers/pins/",
      "pagination": {
        "type": "none"
      },
      "extraction": {
        "format": "json",
        "itemSelector": "data.pins",
        "fields": {
          "id": { "jsonPath": "id" },
          "title": { "jsonPath": "description", "defaultValue": "Anime Wallpaper" },
          "thumbnailUrl": { "jsonPath": "images.237x.url" },
          "fullUrl": { "jsonPath": "images.orig.url" },
          "sourceUrl": { "jsonPath": "link" }
        }
      }
    },
    {
      "id": "nature",
      "title": "Nature & Landscapes",
      "url": "https://api.pinterest.com/v3/pidgets/boards/wallpapersden/nature-wallpapers/pins/",
      "pagination": {
        "type": "none"
      },
      "extraction": {
        "format": "json",
        "itemSelector": "data.pins",
        "fields": {
          "id": { "jsonPath": "id" },
          "title": { "jsonPath": "description", "defaultValue": "Nature Wallpaper" },
          "thumbnailUrl": { "jsonPath": "images.237x.url" },
          "fullUrl": { "jsonPath": "images.orig.url" },
          "sourceUrl": { "jsonPath": "link" }
        }
      }
    }
  ]
}
